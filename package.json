{
  "name": "nms-vault",
  "version": "0.1.0",
  "description": "Local, non-destructive inventory manager for No Man's Sky saves",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js --no-open",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:gamedata": "E2E_GAMEDATA=1 playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
